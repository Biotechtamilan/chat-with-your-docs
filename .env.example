# Copy this file to .env.local and fill in the key. .env.local is gitignored.
#
# You can also connect a model from the screen instead: Settings, then Connection.
# A connection saved there is kept in DATA_DIR/connection.json and overrides the
# connection variables in this file until you choose "Forget this connection".

# Vercel AI Gateway key (Vercel dashboard -> AI Gateway -> API Keys).
# A standard key or a Token Pass-scoped key both work: this app only calls
# chat models through the gateway. Leave it empty to run in offline mode,
# where search works and answers are quoted passages instead of model text.
AI_GATEWAY_API_KEY=

# Using a different provider instead? Set ONE of these and name a model your key can use.
# The gateway above is the tested default; see the README for what was verified.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# Any OpenAI-compatible server (OpenRouter, Groq, Together):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# CHAT_MODEL=<model id for that provider>
# LLM_PROVIDER=openai          # only needed when several keys are set
# REASONING=none               # default for the gateway; "default" leaves the provider's behaviour

# Running fully local: a model on this machine, no key. Embeddings are already
# local, so nothing leaves the machine. Leave the keys above empty (or set
# LLM_PROVIDER=openai-compatible). Reading scans needs a model that accepts images.
# An address on localhost, 127.0.0.1, ::1 or a private network is shown as "Local model".
# Verified only against the gateway's OpenAI-compatible endpoint, not a local server.
# LLM_BASE_URL=http://localhost:11434/v1     # Ollama
# LLM_BASE_URL=http://localhost:1234/v1      # LM Studio
# LLM_BASE_URL=http://localhost:8000/v1      # vLLM
# CHAT_MODEL=llama3.2
# REASONING=none               # only if the model returns no text because it spent its budget thinking

# Default chat model. Must be one of CHAT_MODELS.
# CHAT_MODEL=deepseek/deepseek-v4.1-flash-1017

# Models the picker offers (comma-separated gateway ids).
# CHAT_MODELS=deepseek/deepseek-v4.1-flash-1017,deepseek/deepseek-v4.1-flash,zai/glm-5.3-flash,zai/glm-5.3,moonshotai/kimi-k3.1-pro,moonshotai/kimi-k3

# Local embedding model (Hugging Face id, downloaded once to DATA_DIR/models).
# Changing it starts a fresh index, because vectors from different models do not mix.
# EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
# EMBEDDING_DIMENSIONS=384

# Where the embedded database and the model cache live.
# DATA_DIR=.data

# Scanned pages read by the model per file (0 turns scan reading off).
# OCR_MAX_PAGES=20
# Pixel budget for one rendered scan page. Larger pages are rendered at a lower
# scale; a page that cannot fit even at its own size is refused.
# OCR_MAX_PAGE_PIXELS=16000000

# Requests per minute. Questions, source guides, uploads and "Check connection"
# each count against their own allowance; guides use the same number as questions.
# Every client shares one allowance unless TRUST_PROXY=true.
# RATE_LIMIT_PER_MINUTE=30
# INGEST_RATE_LIMIT_PER_MINUTE=30
# HEALTH_CHECK_RATE_LIMIT_PER_MINUTE=6
# Set to true only behind a proxy you control that appends X-Forwarded-For.
# TRUST_PROXY=false

# The Connection panel: saves and forgets per minute, counted before the request is
# authorized, so refused attempts use it up (each tested save is a real model request).
# CONNECTION_RATE_LIMIT_PER_MINUTE=6
# Who may change the connection. The app has no login. When the server listens on
# 127.0.0.1 only (npm run dev and npm start do) with no proxy in front, programs on
# this machine may, and nothing is needed here. When it accepts connections from
# other machines (Docker, --hostname 0.0.0.0) or sits behind a proxy, the panel is
# read-only unless this token is set. Once set it is required for every change,
# on localhost too, and the panel asks for it. At least 24 characters, for
# example from: openssl rand -hex 24. Never logged, never sent to the browser.
# SETTINGS_TOKEN=

# Source guide: how many characters of the selected sources' opening passages the model reads.
# GUIDE_INPUT_CHARS=12000
# Most notes the notebook keeps.
# MAX_NOTES=500

# Library and upload limits.
# MAX_DOCUMENTS=50
# MAX_UPLOAD_MB=15

# Retrieval tuning.
# TOP_K=6
# CANDIDATES_PER_LEG=20
# MIN_SIMILARITY=0.5
